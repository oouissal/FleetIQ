# ============================================================
# FleetIQ - Environment Configuration (example)
# Copy this file to `.env` and adjust values for your machine.
# NEVER commit the real `.env` file.
# ============================================================

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=fleetiq
MINIO_ROOT_PASSWORD=change-me-strong-password
MINIO_ENDPOINT=minio:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Apache Kafka (KRaft single node) ---
KAFKA_BROKER=kafka:9092
KAFKA_BROKER_HOST=kafka
KAFKA_LISTENER_PORT=9092
KAFKA_TOPIC_TELEMETRY=fleet.telemetry
KAFKA_TOPIC_GPS=fleet.gps
KAFKA_TOPIC_DELIVERY=fleet.delivery

# MLflow 3.x: the local filesystem tracking store is in maintenance mode.
# Enable it explicitly when you want the classic ./mlruns directory.
MLFLOW_ALLOW_FILE_STORE=true
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=supply-chain-intelligence
MLFLOW_ARTIFACT_ROOT=s3://mlflow

# --- Backend API ---
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost
DATA_LAKE_ROOT=s3a://silver
GOLD_ROOT=s3a://gold
MODEL_REGISTRY_URI=http://mlflow:5000
ETA_MODEL_NAME=eta_prediction
ANOMALY_MODEL_NAME=anomaly_detection

# --- Data generator ---
GENERATOR_VEHICLES=500
GENERATOR_EVENTS_PER_SECOND=50
GENERATOR_SEED=42

# --- Frontend ---
VITE_API_BASE_URL=/api
FRONTEND_PORT=8081
